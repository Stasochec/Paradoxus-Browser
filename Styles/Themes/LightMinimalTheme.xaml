    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{StaticResource PopupBackgroundColor}" />

    <Color x:Key="BorderColor">#D1D5DB</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <Color x:Key="ItemHoverColor">#F3F4F6</Color>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="{StaticResource ItemHoverColor}" />
</ResourceDictionary>
