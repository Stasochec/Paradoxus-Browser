<UserControl x:Class="ParadoxusBrowser.Views.Controls.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="24" d:DesignWidth="44">
    <Grid>
        <CheckBox x:Name="InternalCheckBox"
                  IsChecked="{Binding IsToggled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                  Cursor="Hand"
                  FocusVisualStyle="{x:Null}">
            <CheckBox.Template>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Background Container Track -->
                    <Border x:Name="Track"
                            Width="44"
                            Height="24"
                            CornerRadius="12"
                            Background="#383A43"
                            BorderBrush="#4F525F"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <!-- Thumb Slider Knob -->
                        <Ellipse x:Name="Thumb"
                                 Width="18"
                                 Height="18"
                                 Margin="3,0,0,0"
                                 Fill="#FFFFFF"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Smooth Animation when IsChecked becomes True or False -->
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         To="20"
                                                         Duration="0:0:0.15"
                                                         DecelerationRatio="0.7"/>
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#FF7600"
                                                        Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         To="0"
                                                         Duration="0:0:0.15"
                                                         DecelerationRatio="0.7"/>
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#383A43"
                                                        Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#FFA24C" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </CheckBox.Template>
        </CheckBox>
    </Grid>
</UserControl>
