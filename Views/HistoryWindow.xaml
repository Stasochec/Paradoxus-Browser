<Window x:Class="ParadoxusBrowser.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParadoxusBrowser"
        mc:Ignorable="d"
        Title="История посещений — Paradoxus"
        Height="640" Width="760"
        MinHeight="450" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="/Styles/Icons.xaml" />
                <ResourceDictionary Source="/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <!-- Header & Search Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- History Grouped List -->
            <RowDefinition Height="*" />
            <!-- Status / Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Search -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title & Clear All Button -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource BraveOrangeDimBrush}" Margin="0,0,10,0">
                        <Path Data="{StaticResource HistoryIcon}" Width="16" Height="16" Fill="{DynamicResource BraveOrangeBrush}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="История посещений" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        Style="{StaticResource IconButton}"
                        Background="{DynamicResource SurfaceBgBrush}"
                        Padding="12,6"
                        Click="OnClearAllHistoryClick"
                        ToolTip="Удалить всю историю просмотров">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource TrashIcon}" Width="13" Height="13" Fill="{DynamicResource AlertRedBrush}" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="Очистить всю историю" Foreground="{DynamicResource AlertRedBrush}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Live Search Bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="40">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Data="{StaticResource GlobeIcon}" Width="14" Height="14" Fill="{DynamicResource TextMutedBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1"
                             x:Name="SearchTextBox"
                             Style="{StaticResource OmniboxTextBoxStyle}"
                             FontSize="14"
                             TextChanged="OnSearchTextChanged" />

                    <!-- Clear search filter button -->
                    <Button Grid.Column="2"
                            x:Name="ClearFilterButton"
                            Style="{StaticResource IconButton}"
                            Width="24" Height="24"
                            Padding="5"
                            Visibility="Collapsed"
                            Click="OnClearFilterClick"
                            ToolTip="Очистить поиск">
                        <Path Data="{StaticResource CloseIcon}" Fill="{DynamicResource TextMutedBrush}" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Main History Items List with Grouping -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <!-- Empty State Message -->
                <StackPanel x:Name="EmptyStatePanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <Path Data="{StaticResource HistoryIcon}" Width="40" Height="40" Fill="{DynamicResource TextMutedBrush}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.6"/>
                    <TextBlock Text="Записей в истории не найдено" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Grouped Items Scroll List -->
                <ScrollViewer x:Name="HistoryScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                    <ItemsControl x:Name="GroupsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <!-- Date Header -->
                                    <Border Background="{DynamicResource HeaderBgBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding DateHeader}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource BraveOrangeBrush}"/>
                                    </Border>

                                    <!-- Items for this Date -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="ItemRow"
                                                        CornerRadius="6"
                                                        Background="Transparent"
                                                        Padding="8,7"
                                                        Margin="0,1"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="OnHistoryRowClick">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <!-- Time -->
                                                            <ColumnDefinition Width="50" />
                                                            <!-- Favicon -->
                                                            <ColumnDefinition Width="24" />
                                                            <!-- Title & URL -->
                                                            <ColumnDefinition Width="*" />
                                                            <!-- Delete Single Item (X) -->
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Time -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding FormattedTime}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Favicon / Globe -->
                                                        <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <Image Width="14" Height="14"
                                                                   Source="{Binding FaviconUrl}"
                                                                   Visibility="{Binding HasFavicon, Converter={x:Static local:MainWindow.BoolToVisibilityConverter}}"/>
                                                            <Path Width="13" Height="13"
                                                                  Data="{StaticResource GlobeIcon}"
                                                                  Fill="{DynamicResource TextMutedBrush}"
                                                                  Stretch="Uniform"
                                                                  Visibility="{Binding HasFavicon, Converter={x:Static local:MainWindow.InverseBoolToVisibilityConverter}}"/>
                                                        </Grid>

                                                        <!-- Title & URL Stack -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,10,0">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Medium"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Url}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Delete X -->
                                                        <Button Grid.Column="3"
                                                                Style="{StaticResource IconButton}"
                                                                Width="24" Height="24"
                                                                Padding="5"
                                                                VerticalAlignment="Center"
                                                                Click="OnDeleteHistoryItemClick"
                                                                Tag="{Binding}"
                                                                ToolTip="Удалить запись">
                                                            <Path Data="{StaticResource CloseIcon}" Fill="{DynamicResource TextMutedBrush}" Stretch="Uniform" Width="9" Height="9" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer Info -->
        <TextBlock Grid.Row="2"
                   x:Name="StatusTextBlock"
                   Text="Всего записей: 0"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   Margin="4,10,0,0"/>
    </Grid>
</Window>