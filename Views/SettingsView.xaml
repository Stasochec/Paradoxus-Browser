<UserControl x:Class="ParadoxusBrowser.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:ParadoxusBrowser.Views.Controls"
             xmlns:local="clr-namespace:ParadoxusBrowser"
             mc:Ignorable="d"
             d:DesignHeight="1400" d:DesignWidth="1050"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Background="{DynamicResource BgDarkBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <!-- Interactive Category Button Style with Active Indicator -->
        <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BraveOrangeBrush}"
                                BorderThickness="0"
                                CornerRadius="0,16,16,0"
                                Margin="0,2,12,2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

<!-- Common Settings Card Border Style -->
        <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="260" />
            <!-- Content -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,20,0,20">
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,24">
                        <Path Data="{StaticResource ParadoxusLogoIcon}" Width="24" Height="24" Fill="{DynamicResource BraveOrangeBrush}" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Navigation Links -->
                    <!-- Appearance -->
                    <Button Content="Внешний вид"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Appearance">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAppearanceCategorySelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BraveOrangeDimBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BraveOrangeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Content -->
                    <Button Content="Содержимое страниц"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Content">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsContentCategorySelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BraveOrangeDimBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BraveOrangeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Shields -->
                    <Button Content="Щиты и защита"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Shields">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShieldsCategorySelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BraveOrangeDimBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BraveOrangeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Privacy -->
                    <Button Content="Конфиденциальность"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Privacy">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPrivacyCategorySelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BraveOrangeDimBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BraveOrangeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Search Engine -->
                    <Button Content="Поисковая система"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Search">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchCategorySelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BraveOrangeDimBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BraveOrangeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Autofill & Passwords -->
                    <Button Content="Автозаполнение и пароли"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Passwords">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordsCategorySelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BraveOrangeDimBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BraveOrangeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Downloads -->
                    <Button Content="Скачанные файлы"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Downloads">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloadsCategorySelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BraveOrangeDimBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BraveOrangeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- System & Performance -->
                    <Button Content="Система и производительность"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="System">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemCategorySelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BraveOrangeDimBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BraveOrangeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- About -->
                    <Button Content="О браузере Paradoxus"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="About">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutCategorySelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BraveOrangeDimBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BraveOrangeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="40,30">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                
                <!-- Live Search Bar -->
                <Border Background="{DynamicResource SurfaceBgBrush}"
                        CornerRadius="18"
                        Height="40"
                        Margin="0,0,0,28"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource CommandPaletteIcon}" Width="15" Height="15" Fill="{DynamicResource TextMutedBrush}" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource OmniboxTextBoxStyle}"
                                 FontSize="13"
                                 VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ========================================== -->
                <!-- Section: Appearance                        -->
                <!-- ========================================== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAppearanceCategorySelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSettingsSearch}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Внешний вид" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Цветовая тема" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <RadioButton Content="Paradoxus Dark (Графит)" GroupName="ThemeGroup" IsChecked="{Binding IsParadoxusDarkTheme}" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <RadioButton Content="Midnight OLED (Глубокий чёрный)" GroupName="ThemeGroup" IsChecked="{Binding IsOledMidnightTheme}" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <RadioButton Content="Paradoxus Light (Светлая чистая)" GroupName="ThemeGroup" IsChecked="{Binding IsLightMinimalTheme}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========================================== -->
                <!-- Section: Content (Содержимое страниц)      -->
                <!-- ========================================== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsContentCategorySelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSettingsSearch}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Содержимое веб-страниц" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />

                    <!-- Font Size -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Размер шрифта" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Управляет базовым размером шрифта на отображаемых страницах." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      
                                      SelectedValue="{Binding SelectedFontSize}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="Мелкий" />
                                <ComboBoxItem Content="Средний (рекомендуется)" />
                                <ComboBoxItem Content="Крупный" />
                                <ComboBoxItem Content="Очень крупный" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Page Zoom -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Масштаб страницы" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Масштаб отображения страниц по умолчанию." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      
                                      SelectedValue="{Binding SelectedPageZoom}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="25%" />
                                <ComboBoxItem Content="50%" />
                                <ComboBoxItem Content="75%" />
                                <ComboBoxItem Content="100%" />
                                <ComboBoxItem Content="110%" />
                                <ComboBoxItem Content="125%" />
                                <ComboBoxItem Content="150%" />
                                <ComboBoxItem Content="175%" />
                                <ComboBoxItem Content="200%" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- MRU Tab Cycling -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Переключение вкладок в порядке использования (MRU)" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Сочетание клавиш Ctrl+Tab циклически переключает вкладки по времени их последнего открытия." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding CycleTabsMruEnabled}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Wayback Machine on 404 -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Предлагать копию в Wayback Machine при ошибке 404" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Автоматически проверять наличие архивной копии в Internet Archive Wayback Machine, если страница недоступна." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding WaybackMachineEnabled}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Speedreader -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Режим Speedreader" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Автоматически очищать страницы со статьями от баннеров и навигации для комфортного чтения." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding SpeedreaderEnabled}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========================================== -->
                <!-- Section: Shields & Protection              -->
                <!-- ========================================== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShieldsCategorySelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSettingsSearch}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Щиты и защита" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />

                    <!-- Global Shields Toggle -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Paradoxus Shields по умолчанию" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Блокировать трекеры, межсайтовые куки и навязчивую рекламу во всех новых вкладках." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding GlobalShieldsEnabled}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- AdBlock Mode -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Блокировка трекеров и рекламы" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Степень фильтрации рекламных баннеров и аналитических трекеров." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      
                                      SelectedValue="{Binding AdBlockMode}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="Стандартная" />
                                <ComboBoxItem Content="Агрессивная" />
                                <ComboBoxItem Content="Отключено" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- HTTPS Upgrade Mode -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Повышение безопасности соединений (HTTPS)" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Автоматический апгрейд незащищенных HTTP-подключений до безопасного шифрованного HTTPS." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      
                                      SelectedValue="{Binding HttpsUpgradeMode}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="Стандартная" />
                                <ComboBoxItem Content="Строгая (только HTTPS)" />
                                <ComboBoxItem Content="Отключено" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Block Scripts (JS) -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Блокировать скрипты (JavaScript)" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Полностью отключает выполнение клиентского JavaScript на страницах для максимальной изоляции." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding BlockScriptsEnabled}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Fingerprinting Protection -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Защита от цифровых отпечатков (Fingerprinting)" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Рандомизирует отпечатки Canvas, Audio API и WebGL, предотвращая идентификацию пользователя." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding FingerprintingProtectionEnabled}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Cookie Blocking Mode -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Блокировка файлов cookie" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Правила обработки сторонних файлов cookie и межсайтового слежения." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      
                                      SelectedValue="{Binding CookieBlockingMode}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="Блокировать межсайтовые куки" />
                                <ComboBoxItem Content="Блокировать все куки (не рекомендуется)" />
                                <ComboBoxItem Content="Разрешить все куки" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Clear Data On Exit -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Очищать данные при выходе из браузера" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Автоматически стирать историю, кэш и cookies при каждом закрытии приложения." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding ClearDataOnExitEnabled}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========================================== -->
                <!-- Section: Autofill & Passwords              -->
                <!-- ========================================== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordsCategorySelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSettingsSearch}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Автозаполнение и пароли" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />

                    <!-- Password Manager Card -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource KeyIcon}" Width="16" Height="16" Fill="{DynamicResource BraveOrangeBrush}" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding SavedPasswordsHeader}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Ваши учетные данные надежно зашифрованы ключом текущего пользователя Windows DPAPI. Никакие третьи лица не имеют доступа к вашим паролям."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" />

                            <!-- Add Password Form -->
                            <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,18" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Добавить учетную запись" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Site URL -->
                                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Height="34" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <TextBox Style="{StaticResource OmniboxTextBoxStyle}"
                                                     Text="{Binding NewPasswordSiteUrl, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="8,0"
                                                     ToolTip="URL или сайт (например: https://github.com)" />
                                        </Border>

                                        <!-- Username -->
                                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Height="34" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <TextBox Style="{StaticResource OmniboxTextBoxStyle}"
                                                     Text="{Binding NewPasswordUsername, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="8,0"
                                                     ToolTip="Логин / Email" />
                                        </Border>

                                        <!-- Password -->
                                        <Border Grid.Column="4" Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Height="34" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <TextBox Style="{StaticResource OmniboxTextBoxStyle}"
                                                     Text="{Binding NewPasswordValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="8,0"
                                                     ToolTip="Пароль" />
                                        </Border>

                                        <!-- Save Button -->
                                        <Button Grid.Column="6"
                                                Content="Сохранить"
                                                Style="{StaticResource ShieldsButtonStyle}"
                                                Height="34"
                                                Padding="14,0"
                                                Command="{Binding AddPasswordCommand}"
                                                ToolTip="Сохранить зашифрованный пароль" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Saved Passwords List -->
                            <TextBlock Text="Сохраненные пароли" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <ItemsControl ItemsSource="{Binding SavedPasswords}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgDarkBrush}"
                                                CornerRadius="6"
                                                Padding="12,10"
                                                Margin="0,0,0,8"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Site -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Domain}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SiteUrl}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Username -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Username}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Password Display with Mask -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayPassword}"
                                                               FontFamily="Consolas, Courier New"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <Button Style="{StaticResource IconButton}"
                                                            Width="26" Height="26"
                                                            Padding="4"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.TogglePasswordVisibilityCommand, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Показать / скрыть пароль">
                                                        <Grid>
                                                            <Path Data="{StaticResource EyeIcon}"
                                                                  Width="13" Height="13"
                                                                  Fill="{DynamicResource TextSecondaryBrush}"
                                                                  Stretch="Uniform"
                                                                  Visibility="{Binding IsPasswordVisible, Converter={x:Static local:MainWindow.InverseBoolToVisibilityConverter}}"/>
                                                            <Path Data="{StaticResource EyeOffIcon}"
                                                                  Width="13" Height="13"
                                                                  Fill="{DynamicResource BraveOrangeBrush}"
                                                                  Stretch="Uniform"
                                                                  Visibility="{Binding IsPasswordVisible, Converter={x:Static local:MainWindow.BoolToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Delete Button -->
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource IconButton}"
                                                        Width="28" Height="28"
                                                        Padding="5"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.DeletePasswordCommand, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Удалить сохраненный пароль">
                                                    <Path Data="{StaticResource TrashIcon}" Width="13" Height="13" Fill="{DynamicResource AlertRedBrush}" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Payment Methods Card -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Способы оплаты" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Управление сохраненными банковскими картами и платежными данными." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Настроить"
                                    Style="{StaticResource ShieldsButtonStyle}"
                                    Height="32"
                                    Padding="14,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenPaymentMethodsCommand}" />
                        </Grid>
                    </Border>

                    <!-- Addresses Card -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Адреса и другие данные" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Сохраненные адреса для автоматического заполнения веб-форм." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Настроить"
                                    Style="{StaticResource ShieldsButtonStyle}"
                                    Height="32"
                                    Padding="14,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenAddressesCommand}" />
                        </Grid>
                    </Border>

                    <!-- Incognito Autofill Toggle -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Автозаполнение в приватных окнах" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Разрешить использование сохраненных учетных данных в режиме приватного просмотра." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding IncognitoAutofillEnabled}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========================================== -->
                <!-- Section: Downloads (Скачанные файлы)       -->
                <!-- ========================================== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDownloadsCategorySelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSettingsSearch}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Скачанные файлы" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />

                    <!-- Download Folder Location -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Местоположение папки загрузок" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DownloadFolderPath}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Изменить"
                                    Style="{StaticResource ShieldsButtonStyle}"
                                    Height="32"
                                    Padding="16,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ChangeDownloadFolderCommand}" />
                        </Grid>
                    </Border>

                    <!-- Ask Where to Save -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Всегда указывать место для скачивания каждого файла" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Запрашивать путь сохранения в проводнике Windows перед каждой загрузкой." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding AskWhereToSaveEnabled}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Notify Download Completed -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Показывать уведомление по завершении скачивания" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Отображать статус и панель загрузок при сохранении файла на диск." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding NotifyDownloadCompletedEnabled}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========================================== -->
                <!-- Section: Search Engine                     -->
                <!-- ========================================== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchCategorySelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSettingsSearch}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Поисковая система" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Поисковая система по умолчанию" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <RadioButton Content="Яндекс" GroupName="SearchGroup" IsChecked="{Binding IsYandexSearch}" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <RadioButton Content="Google" GroupName="SearchGroup" IsChecked="{Binding IsGoogleSearch}" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <RadioButton Content="DuckDuckGo (Приватный)" GroupName="SearchGroup" IsChecked="{Binding IsDuckDuckGoSearch}" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <RadioButton Content="Bing" GroupName="SearchGroup" IsChecked="{Binding IsBingSearch}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========================================== -->
                <!-- Section: System / Performance              -->
                <!-- ========================================== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSystemCategorySelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSettingsSearch}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Система и производительность" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />
                    
                    <!-- GPU Acceleration -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Аппаратное ускорение (GPU)" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Использовать аппаратное ускорение видеочипом (при наличии). Требуется перезапуск браузера." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding HardwareAccelerationEnabled}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Sleeping Tabs (Memory optimization) -->
                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Выгрузка неактивных вкладок из памяти (Sleeping Tabs)" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Автоматически оптимизирует и освобождает оперативную память фоновых страниц для максимального быстродействия." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,16,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding SleepingTabsEnabled}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========================================== -->
                <!-- Section: Privacy & Data                    -->
                <!-- ========================================== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPrivacyCategorySelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSettingsSearch}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Конфиденциальность и данные" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Быстрая очистка данных" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Выборочное или полное удаление сохранённой информации о посещённых сайтах." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />

                            <WrapPanel Orientation="Horizontal">
                                <Button Content="Очистить историю"
                                        Command="{Binding ClearHistoryOnlyCommand}"
                                        Padding="14,8" Margin="0,0,10,8"
                                        Cursor="Hand"
                                        Background="{DynamicResource SurfaceActiveBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="Очистить кэш"
                                        Command="{Binding ClearCacheOnlyCommand}"
                                        Padding="14,8" Margin="0,0,10,8"
                                        Cursor="Hand"
                                        Background="{DynamicResource SurfaceActiveBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="Очистить Cookies"
                                        Command="{Binding ClearCookiesOnlyCommand}"
                                        Padding="14,8" Margin="0,0,10,8"
                                        Cursor="Hand"
                                        Background="{DynamicResource SurfaceActiveBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="Очистить всё (История + Кэш + Cookies)"
                                        Command="{Binding ClearBrowsingDataCommand}"
                                        Padding="14,8" Margin="0,0,10,8"
                                        Cursor="Hand"
                                        Background="{DynamicResource SurfaceActiveBrush}"
                                        Foreground="{DynamicResource AlertRedBrush}"
                                        BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                    </Button.Resources>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========================================== -->
                <!-- Section: About                             -->
                <!-- ========================================== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAboutCategorySelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSettingsSearch}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="О браузере Paradoxus" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />

                    <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,40">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Data="{StaticResource ParadoxusLogoIcon}" Width="36" Height="36" Fill="{DynamicResource BraveOrangeBrush}" Stretch="Uniform" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Paradoxus Browser" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="{Binding BrowserVersion, StringFormat='Версия {0} (64-бит, .NET 8)'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ChromiumVersion, StringFormat='Движок Chromium WebView2: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Приватный, сверхбыстрый и безопасный десктопный браузер с аппаратным шифрованием DPAPI и интеллектуальными щитами Paradoxus Shields." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,16" />

                            <!-- Check Updates Button -->
                            <Button Content="Проверить обновления"
                                     Command="{Binding CheckForUpdatesCommand}"
                                     Style="{StaticResource ShieldsButtonStyle}"
                                     Height="34"
                                     Padding="16,0"
                                     HorizontalAlignment="Left"
                                     ToolTip="Проверить наличие новой версии" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>